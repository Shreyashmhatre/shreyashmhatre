# Run: python3 scripts/init_env.py (generates real random secrets in .env)
ZT_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ZT_ADMIN_PASSWORD=replace-with-a-long-unique-password
ZT_DEMO_PASSWORD=replace-with-a-different-demo-password
ZT_DATABASE_PASSWORD=replace-with-a-generated-database-password
ZT_ADMIN_USERNAME=admin
ZT_UPSTREAM_URL=http://127.0.0.1:8001
ZT_DATABASE_URL=sqlite+aiosqlite:///./data/events.db
# Empty Redis URL enables bounded, SINGLE-PROCESS local state only.
ZT_REDIS_URL=
ZT_MODEL_PATH=ml/artifacts/isolation_forest.joblib
ZT_REQUESTS_PER_MINUTE=60
ZT_QUARANTINE_SECONDS=120
ZT_MAX_BODY_BYTES=65536
